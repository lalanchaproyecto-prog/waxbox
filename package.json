{
  "name": "waxbox",
  "version": "1.0.0",
  "description": "Melôfyle — Keep your music. Cataloga tu colección de música en formatos físicos.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "publicar": "electron-vite build && electron-builder --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lalanchaproyecto-prog/melofyle"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.7.5",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "node-vibrant": "^4.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.11.0"
  },
  "build": {
    "appId": "com.melofyle.app",
    "productName": "Melôfyle",
    "artifactName": "Melofyle-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lalanchaproyecto-prog",
        "repo": "melofyle"
      }
    ]
  }
}
